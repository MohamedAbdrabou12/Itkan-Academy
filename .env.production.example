# ══════════════════════════════════════════════════════════════
#  PRODUCTION  –  Copy this to .env.production and fill values
# ══════════════════════════════════════════════════════════════

# ─── Application ───────────────────────────────────────────
APP_NAME=Itkan Academy
ENV=production

# ─── Database (PostgreSQL) ─────────────────────────────────
POSTGRES_USER=itkan_prod
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=itkan_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ─── Security ──────────────────────────────────────────────
SECRET_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_64

# ─── Redis / Celery Broker ─────────────────────────────────
BROKER_URL=redis://redis:6379/0

# ─── Email (SMTP) ─────────────────────────────────────────
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=noreply@yourdomain.com
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_STARTTLS=True
MAIL_SSL_TLS=False
USE_CREDENTIALS=True

# ─── Frontend URL ─────────────────────────────────────────
FRONTEND_URL=https://yourdomain.com

# ─── CORS Allowed Origins (comma-separated) ───────────────
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ─── Frontend build-time variable ─────────────────────────
VITE_APP_API_URL=https://yourdomain.com/api/v1
